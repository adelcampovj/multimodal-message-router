# Python bytecode and interpreter caches
__pycache__/
*.pyc
*.pyo

# Test, type-check, and lint caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
.tox/

# Coverage
.coverage
.coverage.*
htmlcov/

# Build and distribution metadata
build/
dist/
*.egg-info/

# Virtual environments
.venv/
venv/
env/

# Environment and secret files
.env
.env.*

# Editor and OS temporary files
.DS_Store
Thumbs.db
desktop.ini
*.swp
*.swo
*~
*.bak

# Local logs
*.log

# Generated datasets, media, and run outputs -- this project never commits
# generated or downloaded data; anything under these paths is local-only.
data/
media/
outputs/
results/

# Anything resembling transcript, audit, or incident material must never be
# tracked in this repository.
*transcript*
*incident*
*forensic*

# Anything resembling a packaged submission bundle stays untracked.
submission/
